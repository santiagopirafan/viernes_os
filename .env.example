# API del motor LLM (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# Rate limit del canal CLI (mensajes por minuto)
CLI_RATE_LIMIT=10

# Dashboard Command Center
DASHBOARD_PORT=3911
DASHBOARD_TOKEN=

# WhatsApp Cloud API (Fase 3)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALLOWED_IDS=

# Power BI Service (publicación directa del dataset financiero)
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_NAME=viernes-finanzas

# Google Sheets (panel financiero con gráficas)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=
GOOGLE_SHARE_EMAIL=
GOOGLE_SHEETS_TITLE=Viernes Finanzas
# Alternativa OAuth (si tu organización bloquea llaves de servicio)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
